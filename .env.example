# `full` contains the default embedding model; `slim` downloads it only when
# a user first indexes a custom corpus.
LAB_IMAGE_VARIANT=full
TINY_RAG_LAB_PORT=8000

# Optional OpenAI-compatible provider for Live Ask. Leave blank for offline
# trace replay and retrieval-only exploration.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
